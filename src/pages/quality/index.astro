---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { qualityPages } from "../../data/pages";
---
<BaseLayout title="Quality and Food Safety" description="Ashok Gopal quality pages for FSSAI, vitamin enrichment, storage hygiene, and lab report placeholders.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Quality", href: "/quality/" }]} />
  <PageHero eyebrow="Quality and compliance" title="Make every claim document-backed and easy to verify." description="Edible oil buyers need trust. This section is structured for FSSAI details, nutrition label proof, hygiene discipline, and lab report uploads once available." image="/placeholders/social-packaging.webp" primaryHref="/quality/fssai/" primaryLabel="FSSAI details" secondaryHref="/quality/lab-reports/" secondaryLabel="Lab report slots" />

  <section class="grid three section">
    {qualityPages.map((page) => (
      <a class="card text-card" href={`/quality/${page.slug}/`}>
        <span class="eyebrow">{page.eyebrow}</span>
        <h3>{page.title}</h3>
        <p>{page.description}</p>
      </a>
    ))}
  </section>

  <section class="section amber-block">
    <p class="eyebrow">Claim discipline</p>
    <h2>Keep the website trustworthy by avoiding unsupported health promises.</h2>
    <p>Use packaging-backed wording, document-backed quality statements, and verified certifications. Where proof is not uploaded yet, keep the copy as a placeholder and do not overstate.</p>
  </section>
  <CTA />
</BaseLayout>
