<BaseLayout title="Restaurant Mustard Oil Supply" description="Bulk mustard oil supply page for restaurants, caterers, cloud kitchens, and food-service buyers.">
  <PageHero eyebrow="Food service" title="Bulk mustard oil supply for restaurants and caterers." description="This page is for buyers who need 5 litre, 15 litre, or 15 kg packs and want predictable repeat supply." image="/placeholders/product-tin.webp" primaryHref="/wholesale/restaurant-supply/" primaryLabel="Restaurant enquiry" secondaryHref="/products/kacchi-ghani-mustard-oil-15kg-tin/" secondaryLabel="15 kg tin" />
  <section class="grid three section"><div class="card text-card"><h3>Commercial packs</h3><p>5 litre jar, 15 litre tin, and 15 kg tin pages support food-service enquiries.</p></div><div class="card text-card"><h3>Repeat supply</h3><p>Ask for monthly consumption and delivery cadence.</p></div><div class="card text-card"><h3>Billing</h3><p>Capture GST details and firm information during enquiry.</p></div></section>
  <CTA />
</BaseLayout>
