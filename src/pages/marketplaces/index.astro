---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CollectionSchema from "../../components/CollectionSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { marketplacePages } from "../../data/marketplacePages";
---
<BaseLayout title="Marketplace Readiness" description="Amazon, Flipkart, JioMart, IndiaMART, GeM, wholesale and WhatsApp catalogue readiness for Ashok Gopal mustard oil.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Marketplace Readiness", href: "/marketplaces/" }]} />
  <CollectionSchema slot="head" name="Marketplace Readiness" description="Marketplace and wholesale listing readiness pages for Ashok Gopal mustard oil." path="/marketplaces/" items={marketplacePages.map((page) => ({ name: page.title, href: `/marketplaces/${page.slug}/` }))} />
  <PageHero eyebrow="Marketplace and channel ops" title="Prepare every channel before listing the product." description="Marketplace pages are internal-operational SEO pages for Amazon, Flipkart, JioMart, IndiaMART, GeM, WhatsApp catalogue, retail shelf and wholesale rate-card readiness." image="/placeholders/social-packaging.svg" primaryHref="/catalogue/" primaryLabel="Open catalogue" secondaryHref="/rate-card/" secondaryLabel="Rate card workflow" />
  <section class="section grid three">
    {marketplacePages.map((page) => <a class="card text-card" href={`/marketplaces/${page.slug}/`}><p class="eyebrow">{page.channel}</p><h3>{page.title}</h3><p>{page.summary}</p></a>)}
  </section>
</BaseLayout>
