---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
---
<BaseLayout title="Downloads" description="Download placeholders for Ashok Gopal catalogue, rate card, product images, FSSAI proof, lab reports and distributor documents.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Downloads", href: "/downloads/" }]} />
  <section class="page-hero"><p class="eyebrow">Download centre</p><h1>Prepare the files buyers ask for.</h1><p class="lead">Keep this page as a controlled download hub for sales and procurement assets. Replace placeholder cards with PDFs/images once final documents are ready.</p></section>
  <section class="section grid three">
    {["Product catalogue PDF", "Wholesale rate-card request", "FSSAI certificate", "Lab report", "Product image pack", "Distributor onboarding form", "Retail shelf poster", "WhatsApp product cards", "Marketplace SKU sheet"].map((item) => <div class="card text-card"><p class="eyebrow">Asset</p><h3>{item}</h3><p>Placeholder. Upload final file, add version date, and decide whether public or gated.</p></div>)}
  </section>
</BaseLayout>
