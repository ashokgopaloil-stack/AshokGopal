---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { recipes } from "../../data/recipes";
---
<BaseLayout title="Bengali Cooking with Mustard Oil" description="Recipe and heritage-cooking hub for mustard oil, Bengali kitchens, fish curry, begun bhaja, pickle, panch phoron, and social content landing pages.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Heritage Cooking", href: "/heritage-cooking/" }]} />
  <PageHero eyebrow="Recipe SEO hub" title="Turn Bengali cooking memory into search traffic and brand trust." description="Every recipe page should eventually get real photos, tested quantities, and a matching Instagram/Facebook post. This is the bridge between social proof and permanent organic traffic." image="/placeholders/social-recipe.webp" primaryHref="/products/kacchi-ghani-mustard-oil-1l/" primaryLabel="View 1 litre bottle" secondaryHref="/social/" secondaryLabel="Social content plan" />

  <section class="grid three section">
    {recipes.map((recipe) => (
      <a class="card product-card" href={`/heritage-cooking/recipes/${recipe.slug}/`}>
        <img src={recipe.image} alt={`${recipe.title} placeholder`} loading="lazy" />
        <div class="card-body">
          <p class="eyebrow">{recipe.category}</p>
          <h3>{recipe.title}</h3>
          <p>{recipe.summary}</p>
        </div>
      </a>
    ))}
  </section>

  <CTA title="Use recipes as a sales asset." text="A distributor can share recipe pages with retailers, and the brand can share product pages under recipe posts. That creates a loop between social, SEO, and trade trust." href="/products/" label="Open catalog" />
</BaseLayout>
