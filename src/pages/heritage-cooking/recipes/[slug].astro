---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import RecipeSchema from "../../../components/RecipeSchema.astro";
import CTA from "../../../components/CTA.astro";
import { recipes } from "../../../data/recipes";

export function getStaticPaths() {
  return recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}
const { recipe } = Astro.props;
const faqs = [
  { question: "Are these final recipes?", answer: "The page structure is ready. Add tested ingredient quantities, final photos, and family-style preparation details before a public recipe campaign." },
  { question: "Why build recipe pages for an oil brand?", answer: "Recipe pages capture regional search, give social posts a permanent URL, and help shoppers understand where the product fits in daily cooking." }
];
---
<BaseLayout title={recipe.title} description={recipe.summary} image={recipe.image}>
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Heritage Cooking", href: "/heritage-cooking/" }, { name: recipe.title, href: `/heritage-cooking/recipes/${recipe.slug}/` }]} />
  <FAQSchema slot="head" faqs={faqs} />
  <RecipeSchema slot="head" recipe={recipe} path={`/heritage-cooking/recipes/${recipe.slug}/`} />
  <section class="product-detail recipe-detail">
    <div class="product-media"><img src={recipe.image} alt={`${recipe.title} placeholder`} /><p class="photo-note">Replace with final cooked dish photo, ingredient photo, and reel thumbnail.</p></div>
    <div>
      <p class="eyebrow">{recipe.category}</p>
      <h1>{recipe.title}</h1>
      <p class="lead">{recipe.summary}</p>
      <p><strong>Mustard oil role:</strong> {recipe.cookingUse}</p>
      <p><strong>Prep:</strong> {recipe.prepTime} · <strong>Cook:</strong> {recipe.cookTime} · <strong>Yield:</strong> {recipe.yield}</p>
      <div class="tag-row">{recipe.keywords.map((keyword) => <span>{keyword}</span>)}</div>
    </div>
  </section>
  {recipe.history && (
    <section class="section">
      <div class="card text-card" style="padding: 2.5rem; background: var(--surface);">
        <p class="eyebrow">Culinary Heritage & Context</p>
        <h2 style="font-family: var(--font-serif); font-size: 2rem; margin: 0 0 1rem; color: var(--brand-dark);">The Story Behind the Recipe</h2>
        <p class="lead" style="font-size: 1.1rem; line-height: 1.7; color: var(--muted); margin: 0;">{recipe.history}</p>
      </div>
    </section>
  )}

  <section class="split-section" style="align-items: start; gap: 3rem; padding-block: 2rem;">
    <div class="card text-card" style="padding: 2rem; background: var(--surface);">
      <p class="eyebrow">Ingredients Checklist</p>
      <h2 style="font-family: var(--font-serif); font-size: 1.8rem; margin: 0 0 1.5rem; color: var(--brand-dark);">What You Need</h2>
      {recipe.ingredients ? (
        <ul style="padding-left: 1.25rem; font-size: 1.05rem; line-height: 1.8; color: var(--ink);">
          {recipe.ingredients.map((ing) => <li>{ing}</li>)}
        </ul>
      ) : (
        <p style="color: var(--muted);">Ingredients quantities to be finalized soon.</p>
      )}
    </div>
    
    <div class="card text-card" style="padding: 2rem; background: var(--surface);">
      <p class="eyebrow">Preparation & Cooking Steps</p>
      <h2 style="font-family: var(--font-serif); font-size: 1.8rem; margin: 0 0 1.5rem; color: var(--brand-dark);">Step-by-Step Directions</h2>
      <ol style="padding-left: 1.25rem; font-size: 1.05rem; line-height: 1.8; color: var(--ink);">
        {recipe.steps.map((step) => <li style="margin-bottom: 0.8rem;">{step}</li>)}
      </ol>
    </div>
  </section>

  {recipe.chefTip && (
    <section class="section claim-disclaimer" style="margin-block: 1rem;">
      <p class="eyebrow">Kacchi Ghani Chef's Secret</p>
      <h3 style="font-family: var(--font-serif); font-size: 1.4rem; margin: 0 0 0.5rem; color: var(--brand-dark);">Mastering Mustard Oil Heat</h3>
      <p style="font-size: 1rem; line-height: 1.6; color: var(--ink); margin: 0;">{recipe.chefTip}</p>
    </section>
  )}
  <section class="faq-block section">
    <h2>Recipe page notes</h2>
    {faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
  </section>
  <CTA title="Pair this recipe with the right SKU." text="For household cooking content, link to the 500 ml and 1 litre packs. For high-volume cooking, link to 5 litre and 15 kg pages." href="/products/" label="View products" />
</BaseLayout>
