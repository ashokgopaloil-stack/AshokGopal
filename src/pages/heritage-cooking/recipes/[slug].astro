---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../../components/BreadcrumbSchema.astro";
import FAQSchema from "../../../components/FAQSchema.astro";
import CTA from "../../../components/CTA.astro";
import { recipes } from "../../../data/recipes";

export function getStaticPaths() {
  return recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}
const { recipe } = Astro.props;
const faqs = [
  { question: "Are these final recipes?", answer: "The page structure is ready. Add tested ingredient quantities, final photos, and family-style preparation details before a public recipe campaign." },
  { question: "Why build recipe pages for an oil brand?", answer: "Recipe pages capture high-intent regional search, give social posts a permanent URL, and help shoppers understand where the product fits in daily cooking." }
];
---
<BaseLayout title={recipe.title} description={recipe.summary} image={recipe.image}>
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Heritage Cooking", href: "/heritage-cooking/" }, { name: recipe.title, href: `/heritage-cooking/recipes/${recipe.slug}/` }]} />
  <FAQSchema slot="head" faqs={faqs} />
  <section class="product-detail recipe-detail">
    <div class="product-media"><img src={recipe.image} alt={`${recipe.title} placeholder`} /><p class="photo-note">Replace with final cooked dish photo, ingredient photo, and reel thumbnail.</p></div>
    <div>
      <p class="eyebrow">{recipe.category}</p>
      <h1>{recipe.title}</h1>
      <p class="lead">{recipe.summary}</p>
      <p><strong>Mustard oil role:</strong> {recipe.cookingUse}</p>
      <div class="tag-row">{recipe.keywords.map((keyword) => <span>{keyword}</span>)}</div>
    </div>
  </section>
  <section class="section amber-block">
    <p class="eyebrow">Draft cooking flow</p>
    <h2>Recipe structure to complete later</h2>
    <ol>{recipe.steps.map((step) => <li>{step}</li>)}</ol>
  </section>
  <section class="faq-block section">
    <h2>Recipe page notes</h2>
    {faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
  </section>
  <CTA title="Pair this recipe with the right SKU." text="For household cooking content, link to the 500 ml and 1 litre packs. For high-volume cooking, link to 5 litre and 15 kg pages." href="/products/" label="View products" />
</BaseLayout>
