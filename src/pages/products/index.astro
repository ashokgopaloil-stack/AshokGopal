---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductFilterGrid from "../../components/ProductFilterGrid.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { products } from "../../data/products";
---
<BaseLayout title="Mustard Oil Products" description="Ashok Gopal kacchi ghani mustard oil catalogue with household bottles, family jars, food-service tins, retail and wholesale pack-size pages.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Products", href: "/products/" }]} />

  <ProductFilterGrid products={products} title="Find the right Ashok Gopal pack." intro="Filter by pack size, buyer type and launch status. Product pages should help a household, kirana shop, restaurant or distributor reach the right enquiry quickly." />

  <section class="section amber-block dense-section">
    <p class="eyebrow">Catalogue logic</p>
    <h2>Each pack size should answer a different buying question.</h2>
    <p>The 1 litre buyer wants daily cooking confidence. The 5 litre jar buyer wants value. The 15 kg tin buyer wants food-service consistency. A distributor wants rotation, carton count and margins. Keep those paths separate instead of forcing everyone through one generic page.</p>
  </section>
</BaseLayout>
