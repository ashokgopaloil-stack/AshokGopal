---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ProductCard from "../../components/ProductCard.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { products } from "../../data/products";
---
<BaseLayout
  title="Mustard Oil Product Catalog"
  description="Explore Ashok Gopal kacchi ghani mustard oil packs for homes, retailers, restaurants, distributors, and institutional buyers."
>
  <Fragment slot="head">
    <BreadcrumbSchema items={[
      { name: "Home", href: "/" },
      { name: "Products", href: "/products/" }
    ]} />
  </Fragment>

  <nav class="breadcrumb"><a href="/">Home</a> / Products</nav>

  <section class="page-hero">
    <p class="eyebrow">Product catalog</p>
    <h1>Clean product pages for every pack size.</h1>
    <p>
      Each Ashok Gopal SKU gets a crawlable URL, product schema, packaging placeholder, and wholesale CTA.
      Add final product photography and price data before launch.
    </p>
  </section>

  <section class="section">
    <SectionHeader
      eyebrow="Kacchi ghani mustard oil"
      title="Current product tree"
      text="The initial tree is mustard oil focused. Later you can add refined oil, blended oil, or other agro-processing products as separate categories."
    />
    <div class="grid products">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>
</BaseLayout>
