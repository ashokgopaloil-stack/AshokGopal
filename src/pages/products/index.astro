---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ProductCard from "../../components/ProductCard.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { products } from "../../data/products";
---
<BaseLayout title="Mustard Oil Products" description="Ashok Gopal kacchi ghani mustard oil product catalog with bottle, jar, tin, retail carton, household, restaurant, and wholesale pack-size pages.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Products", href: "/products/" }]} />
  <PageHero eyebrow="Product catalog" title="Mustard oil product pages for every buyer intent." description="Each SKU page is built for a different conversion path: household purchase, retail shelf, restaurant bulk use, institutional procurement, or distributor carton supply." image="/placeholders/hero-product.svg" primaryHref="/wholesale/" primaryLabel="Trade enquiry" secondaryHref="/quality/" secondaryLabel="Quality proof" />

  <section class="section">
    <div class="grid products">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="section amber-block">
    <p class="eyebrow">Product manager note</p>
    <h2>The catalog is intentionally split by SKU and use case.</h2>
    <p>A 1 litre buyer, a 15 kg tin buyer, and a distributor asking for cartons are not the same lead. Separate pages let search engines and sales conversations match the right landing page to the right person.</p>
  </section>
</BaseLayout>
