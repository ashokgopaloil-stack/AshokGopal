---
import { SITE } from "../../data/site";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ashok Gopal Mustard Oil on Instagram (@ashokgopaloil)</title>
    <meta name="description" content="Follow Ashok Gopal Mustard Oil on Instagram: @ashokgopaloil" />
    <link rel="canonical" href={SITE.social.instagram} />
    <meta http-equiv="refresh" content={`0;url=${SITE.social.instagram}`} />
    <meta name="robots" content="noindex,follow" />
    <script is:inline define:vars={{ url: SITE.social.instagram }}>
      window.location.replace(url);
    </script>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        margin: 0;
        text-align: center;
        background: #fbf7f0;
        color: #2b1f1d;
      }
      .card {
        padding: 2.5rem 2rem;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        max-width: 440px;
        margin: 1rem;
      }
      h2 {
        margin-top: 0;
        color: #6f230f;
      }
      a.button {
        display: inline-block;
        margin-top: 1.25rem;
        padding: 0.75rem 1.5rem;
        background: #6f230f;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
      }
      a.button:hover {
        background: #8b2c13;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h2>Redirecting to Instagram</h2>
      <p>Taking you to Ashok Gopal Mustard Oil on Instagram (<strong>{SITE.social.instagramHandle}</strong>)...</p>
      <a class="button" href={SITE.social.instagram}>Go to {SITE.social.instagramHandle} on Instagram</a>
    </div>
  </body>
</html>
