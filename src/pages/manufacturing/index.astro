---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { manufacturingPages } from "../../data/pages";
---
<BaseLayout title="Mustard Oil Manufacturing" description="Manufacturing process, seed sourcing, filtration, packaging, batch coding, and dispatch discipline for Ashok Gopal kacchi ghani mustard oil.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Manufacturing", href: "/manufacturing/" }]} />
  <PageHero eyebrow="Manufacturing proof" title="Build trust by showing how the oil is made, handled, packed, and dispatched." description="This section is designed for buyers who want more than a brand claim. Add factory photos, process photos, packaging shots, and batch proof as soon as available." image="/placeholders/factory.png" primaryHref="/manufacturing/process/" primaryLabel="See process" secondaryHref="/quality/" secondaryLabel="Quality pages" />

  <section class="grid three section">
    {manufacturingPages.map((page) => (
      <a class="card text-card" href={`/manufacturing/${page.slug}/`}>
        <span class="eyebrow">{page.eyebrow}</span>
        <h3>{page.title}</h3>
        <p>{page.description}</p>
      </a>
    ))}
  </section>

  <section class="timeline section amber-block">
    <div><span>1</span><h3>Seed intake</h3><p>Supplier and lot-level notes.</p></div>
    <div><span>2</span><h3>Cleaning</h3><p>Remove impurities before pressing.</p></div>
    <div><span>3</span><h3>Pressing</h3><p>Explain process in verified terms.</p></div>
    <div><span>4</span><h3>Filtration</h3><p>Settling and handling discipline.</p></div>
    <div><span>5</span><h3>Packing</h3><p>Seal, label, batch, carton, dispatch.</p></div>
  </section>

  <CTA />
</BaseLayout>
