---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { manufacturingPages } from "../../data/pages";

export function getStaticPaths() {
  return manufacturingPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<BaseLayout title={page.title} description={page.description}>
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Manufacturing", href: "/manufacturing/" }, { name: page.title, href: `/manufacturing/${page.slug}/` }]} />
  <section class="page-hero rich-hero">
    <div>
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.title}</h1>
      <p class="lead">{page.description}</p>
    </div>
    <img src="/placeholders/factory.svg" alt="Factory placeholder" />
  </section>
  <section class="grid three section">
    {page.bullets.map((bullet) => <div class="card text-card"><h3>{bullet}</h3><p>Add real operational details, photos, and document proof for this point before launch.</p></div>)}
  </section>
  <section class="split-section amber-block">
    <div>
      <p class="eyebrow">Photo checklist</p>
      <h2>Images needed for this page</h2>
      <ul><li>Factory or machine photo</li><li>Close-up process photo</li><li>Worker/safety/process discipline photo</li><li>Finished goods or dispatch photo</li></ul>
    </div>
    <img src="/placeholders/social-packaging.svg" alt="Manufacturing proof placeholder" loading="lazy" />
  </section>
  <CTA href="/products/" label={page.cta} />
</BaseLayout>
