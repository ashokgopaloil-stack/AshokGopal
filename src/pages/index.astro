---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrganizationSchema from "../components/OrganizationSchema.astro";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductFilterGrid from "../components/ProductFilterGrid.astro";
import CTA from "../components/CTA.astro";
import { SITE, whatsappLink } from "../data/site";
import { products, coreProducts, retailProducts, wholesaleProducts } from "../data/products";
import { buyerUseCases } from "../data/contentPages";

const heroProducts = [
  ...coreProducts,
  ...retailProducts.filter((product) => !coreProducts.includes(product)),
  ...wholesaleProducts.filter((product) => !coreProducts.includes(product))
].slice(0, 3);

const valuePoints = [
  { title: "Quality checked packs", text: "Use real batch, label and dispatch proof as soon as final assets are ready." },
  { title: "Lowest possible quote", text: "Route buyers to current pack-wise rate, quantity and logistics before final pricing." },
  { title: "Retail + wholesale", text: "Households, kirana counters, restaurants and distributors get separate paths." },
  { title: "Bengali kitchen fit", text: "Copy and product pages stay anchored in mustard oil taste, aroma and daily cooking use." }
];

const buyerTiles = buyerUseCases.slice(0, 8);
---
<BaseLayout title={SITE.name} description="Ashok Gopal kacchi ghani mustard oil catalogue for households, retailers, restaurants, distributors and bulk buyers across West Bengal.">
  <OrganizationSchema slot="head" />
  <LocalBusinessSchema slot="head" />

  <section class="home-shopfront">
    <div class="home-shopfront-copy">
      <p class="eyebrow">Kacchi ghani mustard oil · West Bengal</p>
      <h1>Mustard oil packs for homes, shops and bulk buyers.</h1>
      <p class="lead">Show the product range first. Let visitors choose by pack size, buyer type and use case, then send them to WhatsApp or the wholesale form.</p>
      <div class="hero-actions">
        <a class="button" href="/products/">View catalogue</a>
        <a class="button secondary" href="/wholesale/">Get current trade quote</a>
        <a class="button ghost" href={whatsappLink("I want the current Ashok Gopal mustard oil rate list.")}>WhatsApp sales</a>
      </div>
      <div class="home-mini-proof">
        <span>Quality-first positioning</span>
        <span>Lowest possible current quote</span>
        <span>Retail and bulk packs</span>
        <span>Proof slots ready</span>
      </div>
    </div>
    <div class="home-product-rail">
      {heroProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="value-strip" aria-label="Ashok Gopal value points">
    {valuePoints.map((point) => <div><strong>{point.title}</strong><span>{point.text}</span></div>)}
  </section>

  <ProductFilterGrid products={products.slice(0, 12)} title="Start with the pack size." intro="A short, filterable catalogue is more useful than a large hero banner. Use this first screen to move visitors toward the correct pack and enquiry path." compact />

  <section class="section dense-section">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Buyer paths</p>
        <h2>Separate the visitor by buying reason.</h2>
      </div>
      <a href="/buyers/">All buyer pages</a>
    </div>
    <div class="buyer-path-grid">
      {buyerTiles.map((page) => <a class="card text-card" href={`/buyers/${page.slug}/`}><p class="eyebrow">Buyer page</p><h3>{page.title}</h3><p>{page.summary}</p></a>)}
    </div>
  </section>

  <section class="section amber-block dense-section">
    <p class="eyebrow">Design direction</p>
    <h2>Product first, proof second, long SEO copy later.</h2>
    <p>The home page now behaves like a catalogue counter. The large explanation blocks can stay deeper in guide, district, proof and marketplace pages where search visitors need detail.</p>
    <div class="hero-actions">
      <a class="button" href="/quality/">Quality proof</a>
      <a class="button secondary" href="/mustard-oil/">Mustard oil guide</a>
    </div>
  </section>

  <CTA title="Ready to replace placeholders with real product proof." text="Next asset pass should add bottle photos, jar photos, tin photos, carton photos, FSSAI label, MRP panel, batch code and dispatch proof." href="/contact/" label="Send photos and details" />
</BaseLayout>
