---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrganizationSchema from "../components/OrganizationSchema.astro";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import ProductCard from "../components/ProductCard.astro";
import CTA from "../components/CTA.astro";
import { coreProducts, products } from "../data/products";
import { districts } from "../data/districts";
import { SITE, whatsappLink } from "../data/site";
---
<BaseLayout title="Kacchi Ghani Mustard Oil Manufacturer in West Bengal" description="Ashok Gopal is a manufacturing-first mustard oil brand website for product trust, Bengali cooking, retail supply, restaurant supply, and wholesale distributor enquiries.">
  <OrganizationSchema slot="head" />
  <LocalBusinessSchema slot="head" />

  <section class="hero">
    <div>
      <p class="eyebrow">Manufacturer website · West Bengal · Retail and wholesale</p>
      <h1>Kacchi ghani mustard oil built for Bengali kitchens and trade supply.</h1>
      <p class="lead">Ashok Gopal needs to look like a real edible-oil manufacturer: product pages, pack-size clarity, factory trust, quality proof, distributor acquisition, and local SEO built into the site from day one.</p>
      <div class="hero-actions">
        <a class="button" href="/products/">View product catalog</a>
        <a class="button secondary" href="/wholesale/">Become a distributor</a>
        <a class="button ghost" href={whatsappLink("I want to enquire about Ashok Gopal mustard oil.")}>WhatsApp sales</a>
      </div>
    </div>
    <div class="hero-visual">
      <img src="/placeholders/hero-product.svg" alt="Ashok Gopal mustard oil product placeholder" />
      <div class="floating-note">Replace this with bottle, jar, tin, and factory photography.</div>
    </div>
  </section>

  <section class="trust-strip">
    {SITE.trustBadges.map((badge) => <div><strong>{badge}</strong><span>Ready for proof/photo upload</span></div>)}
  </section>

  <section class="section">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Product catalog</p>
        <h2>Core SKUs for household, retail, and wholesale intent.</h2>
      </div>
      <a href="/products/">View all {products.length} product pages →</a>
    </div>
    <div class="grid products">
      {coreProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="split-section amber-block">
    <div>
      <p class="eyebrow">Manufacturing proof</p>
      <h2>Do not sell only taste. Sell trust, process, and supply reliability.</h2>
      <p>The site now separates the emotional consumer story from the operational buyer story. Home cooks need aroma and regional confidence. Distributors need pack sizes, territory clarity, repeat movement, and manufacturer seriousness.</p>
    </div>
    <div class="grid two compact-list">
      <a class="mini-card" href="/manufacturing/process/">Process page</a>
      <a class="mini-card" href="/manufacturing/seed-sourcing/">Seed sourcing</a>
      <a class="mini-card" href="/manufacturing/packaging/">Packaging</a>
      <a class="mini-card" href="/quality/fssai/">FSSAI details</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">District SEO</p>
        <h2>Local trade pages for distributor discovery.</h2>
      </div>
      <a href="/wholesale/">Wholesale hub →</a>
    </div>
    <div class="grid three district-grid">
      {districts.slice(0, 6).map((district) => (
        <a class="card text-card" href={`/wholesale/${district.slug}/`}>
          <span class="eyebrow">West Bengal</span>
          <h3>{district.name}</h3>
          <p>{district.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="split-section">
    <img src="/placeholders/social-recipe.svg" alt="Recipe placeholder" loading="lazy" />
    <div>
      <p class="eyebrow">Social to SEO bridge</p>
      <h2>Turn Instagram and Facebook posts into permanent recipe/search pages.</h2>
      <p>The site has placeholders for recipe posts, packaging posts, shop-counter proof, and distributor announcements. Each social post should eventually point back to a crawlable page, not disappear inside a feed.</p>
      <a class="button secondary" href="/heritage-cooking/">Open recipe hub</a>
    </div>
  </section>

  <CTA />
</BaseLayout>
