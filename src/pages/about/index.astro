---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
---
<BaseLayout title="About" description="About Ashok Gopal, a manufacturing-first mustard oil brand site for Bengali kitchens, retail supply, and wholesale distribution.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "About", href: "/about/" }]} />
  <PageHero eyebrow="Brand story" title="A regional edible-oil brand needs proof, not vague claims." description="Use this page to add the family/company story, factory photos, people behind the brand, old distribution history, and the real reason customers should trust Ashok Gopal." image="/placeholders/founder-story.webp" primaryHref="/manufacturing/" primaryLabel="Manufacturing proof" secondaryHref="/contact/" secondaryLabel="Contact" />
  <section class="grid three section">
    <div class="card text-card"><h3>Origin</h3><p>Add the true origin story, founder details, and why the brand focuses on mustard oil.</p></div>
    <div class="card text-card"><h3>Manufacturing</h3><p>Add factory, machinery, process, and packing details that show operational seriousness.</p></div>
    <div class="card text-card"><h3>Distribution</h3><p>Add where the product is sold, who can enquire, and what kind of trade partners are wanted.</p></div>
  </section>
  <CTA />
</BaseLayout>
