---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { districts } from "../../data/districts";
import { b2bSegments } from "../../data/pages";
import { whatsappLink } from "../../data/site";
import type { District } from "../../data/districts";
import type { LandingPage } from "../../data/pages";

const allPages = [
  ...districts.map((district) => ({ type: "district", slug: district.slug, data: district })),
  ...b2bSegments.map((segment) => ({ type: "segment", slug: segment.slug, data: segment }))
];

export function getStaticPaths() {
  return allPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const isDistrict = page.type === "district";
const data = page.data as District | LandingPage;

// Compute all display values outside JSX for proper type safety
const pageTitle = isDistrict ? (data as District).headline : (data as LandingPage).title;
const pageDescription = isDistrict ? (data as District).summary : (data as LandingPage).description;
const pageEyebrow = isDistrict ? "District trade landing page" : (data as LandingPage).eyebrow;
const pageName = isDistrict ? (data as District).name : (data as LandingPage).title;
const ctaTitle = isDistrict ? `Want Ashok Gopal supply in ${(data as District).name}?` : (data as LandingPage).cta;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Wholesale", href: "/wholesale/" }, { name: pageName, href: `/wholesale/${page.slug}/` }]} />

  <section class="page-hero rich-hero">
    <div>
      <p class="eyebrow">{pageEyebrow}</p>
      <h1>{pageTitle}</h1>
      <p class="lead">{pageDescription}</p>
      <div class="hero-actions">
        <a class="button" href={whatsappLink(`I want to enquire about Ashok Gopal supply for ${pageName}.`)}>WhatsApp enquiry</a>
        <a class="button secondary" href="/wholesale/#wholesale-form">Wholesale form</a>
      </div>
    </div>
    <img src="/placeholders/social-distribution.svg" alt="Distributor and wholesale placeholder" />
  </section>

  {isDistrict ? (
    <section class="grid three section">
      <div class="card text-card"><p class="eyebrow">Buyer types</p><ul>{(data as District).buyerTypes.map((item: string) => <li>{item}</li>)}</ul></div>
      <div class="card text-card"><p class="eyebrow">Priority markets</p><ul>{(data as District).priorityMarkets.map((item: string) => <li>{item}</li>)}</ul></div>
      <div class="card text-card"><p class="eyebrow">Sales angle</p><p>{(data as District).leadAngle}</p></div>
    </section>
  ) : (
    <section class="grid three section">
      {(data as LandingPage).bullets.map((bullet: string) => <div class="card text-card"><p>{bullet}</p></div>)}
    </section>
  )}

  <section class="split-section amber-block">
    <div>
      <p class="eyebrow">What to add later</p>
      <h2>Make this page stronger with proof.</h2>
      <p>Add shop photos, delivery photos, carton photos, distributor testimonials, territory-specific delivery terms, and actual MOQ data once available.</p>
    </div>
    <div class="checklist">
      <span>Real product photo</span>
      <span>Carton quantity</span>
      <span>MOQ or minimum billing</span>
      <span>Delivery zone</span>
      <span>Trade margin note</span>
    </div>
  </section>

  <CTA title={ctaTitle} text="Send business type, district, GSTIN, monthly expected volume, and product pack requirement." href="/wholesale/#wholesale-form" label="Open enquiry form" />
</BaseLayout>
