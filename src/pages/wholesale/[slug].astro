---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { districts } from "../../data/districts";
import { b2bSegments } from "../../data/pages";
import { whatsappLink } from "../../data/site";

export function getStaticPaths() {
  const allPages = [
    ...districts.map((district) => ({ type: "district", slug: district.slug, data: district })),
    ...b2bSegments.map((segment) => ({ type: "segment", slug: segment.slug, data: segment }))
  ];
  return allPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const isDistrict = page.type === "district";
const data: any = page.data;
const pageTitle = isDistrict ? data.headline : data.title;
const pageDescription = isDistrict ? data.summary : data.description;
const crumbName = isDistrict ? data.name : data.title;
const eyebrow = isDistrict ? "District trade landing page" : data.eyebrow;
const bullets: string[] = isDistrict ? [] : data.bullets;
const buyerTypes: string[] = isDistrict ? data.buyerTypes : [];
const priorityMarkets: string[] = isDistrict ? data.priorityMarkets : [];
const ctaTitle = isDistrict ? `Want Ashok Gopal supply in ${data.name}?` : data.cta;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Wholesale", href: "/wholesale/" }, { name: crumbName, href: `/wholesale/${page.slug}/` }]} />

  <section class="page-hero rich-hero">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{pageTitle}</h1>
      <p class="lead">{pageDescription}</p>
      <div class="hero-actions">
        <a class="button" href={whatsappLink(`I want to enquire about Ashok Gopal supply for ${crumbName}.`)}>WhatsApp enquiry</a>
        <a class="button secondary" href="/wholesale/#wholesale-form">Wholesale form</a>
      </div>
    </div>
    <div class="hero-visual"><img src="/placeholders/social-distribution.svg" alt="Distributor and wholesale placeholder" /><p class="floating-note">Replace with real carton, godown, retailer, or dispatch photo for this page.</p></div>
  </section>

  {isDistrict ? (
    <section class="grid three section">
      <div class="card text-card"><p class="eyebrow">Buyer types</p><ul>{buyerTypes.map((item) => <li>{item}</li>)}</ul></div>
      <div class="card text-card"><p class="eyebrow">Priority markets</p><ul>{priorityMarkets.map((item) => <li>{item}</li>)}</ul></div>
      <div class="card text-card"><p class="eyebrow">Sales angle</p><p>{data.leadAngle}</p></div>
    </section>
  ) : (
    <section class="grid three section">
      {bullets.map((bullet) => <div class="card text-card"><p>{bullet}</p></div>)}
    </section>
  )}

  <section class="split-section amber-block">
    <div>
      <p class="eyebrow">What to add later</p>
      <h2>Make this page stronger with proof.</h2>
      <p>Add shop photos, delivery photos, carton photos, distributor testimonials, territory-specific delivery terms, and actual MOQ data once available.</p>
    </div>
    <div class="checklist">
      <span>Real product photo</span>
      <span>Carton quantity</span>
      <span>MOQ or minimum billing</span>
      <span>Delivery zone</span>
      <span>Trade margin note</span>
    </div>
  </section>

  <CTA title={ctaTitle} text="Send business type, district, GSTIN, monthly expected volume, and product pack requirement." href="/wholesale/#wholesale-form" label="Open enquiry form" />
</BaseLayout>
