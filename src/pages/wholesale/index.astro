---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { districts } from "../../data/districts";
import { b2bSegments } from "../../data/pages";
---
<BaseLayout title="Wholesale Mustard Oil Supply" description="Apply for Ashok Gopal wholesale mustard oil supply, distributor partnership, super stockist opportunity, retail supply, restaurant supply, or institutional procurement.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Wholesale", href: "/wholesale/" }]} />
  <PageHero eyebrow="Wholesale and distribution" title="A serious B2B funnel for mustard oil trade partners." description="This page filters serious enquiries by business type, territory, infrastructure, expected volume, and product requirement." image="/placeholders/social-distribution.svg" primaryHref="#wholesale-form" primaryLabel="Fill enquiry form" secondaryHref="/products/kacchi-ghani-mustard-oil-15kg-tin/" secondaryLabel="View 15 kg tin" />

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Choose partner type</p>
      <h2>Separate paths for distributors, super stockists, retailers, restaurants, and institutions.</h2>
    </div>
    <div class="grid three">
      {b2bSegments.map((segment) => (
        <a class="card text-card" href={`/wholesale/${segment.slug}/`}>
          <span class="eyebrow">{segment.eyebrow}</span>
          <h3>{segment.title}</h3>
          <p>{segment.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section amber-block">
    <p class="eyebrow">District landing pages</p>
    <h2>Use district pages to collect local dealer and stockist leads.</h2>
    <div class="grid three district-grid">
      {districts.map((district) => <a class="mini-card" href={`/wholesale/${district.slug}/`}>{district.name}</a>)}
    </div>
  </section>

  <section class="form-shell section" id="wholesale-form">
    <div>
      <p class="eyebrow">Lead qualification</p>
      <h2>Wholesale enquiry form</h2>
      <p>Use this form structure even if the first backend is Netlify Forms or a simple email workflow. It asks for enough data to avoid low-quality leads.</p>
      <ul>
        <li>GSTIN and FSSAI details for trade seriousness.</li>
        <li>Warehouse and vehicle details for logistics fit.</li>
        <li>Districts and monthly volume for territory planning.</li>
      </ul>
    </div>
    <form name="wholesale-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
      <input type="hidden" name="form-name" value="wholesale-enquiry" />
      <p class="hidden"><label>Do not fill this field<input name="bot-field" /></label></p>
      <input type="hidden" name="source_page" value="/wholesale/" />
      <label>Firm name<input name="firm_name" placeholder="Legal / trade name" required /></label>
      <label>Contact person<input name="contact_person" placeholder="Owner / manager name" required /></label>
      <label>Mobile / WhatsApp<input name="mobile" placeholder="10 digit mobile" required /></label>
      <label>Business type<select name="business_type" required><option value="">Select</option><option>Distributor</option><option>Super stockist</option><option>Retailer</option><option>Restaurant / Caterer</option><option>Institutional buyer</option></select></label>
      <label>GSTIN<input name="gstin" placeholder="GSTIN if available" /></label>
      <label>FSSAI license<input name="fssai" placeholder="FSSAI license if applicable" /></label>
      <label>Target districts<input name="districts" placeholder="Kolkata, Howrah, Hooghly..." /></label>
      <label>Monthly volume<select name="monthly_volume"><option>Below 50 cartons</option><option>50-200 cartons</option><option>200-500 cartons</option><option>500+ cartons</option></select></label>
      <label class="full">Requirement<textarea name="requirement" rows="5" placeholder="Tell us pack sizes, territory, delivery expectations, and current brands handled."></textarea></label>
      <button class="button" type="submit">Submit enquiry</button>
    </form>
  </section>

  <CTA title="Prefer WhatsApp first?" text="Send your firm name, city, business type, GSTIN, product pack, and expected monthly requirement." href="/contact/" label="Contact sales" secondaryHref="/products/" secondaryLabel="See products" />
</BaseLayout>
