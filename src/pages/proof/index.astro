---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CollectionSchema from "../../components/CollectionSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { proofPages } from "../../data/proofPages";
---
<BaseLayout title="Proof Library" description="Factory, product, label, batch, stock, dispatch and trade proof pages for Ashok Gopal mustard oil.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Proof Library", href: "/proof/" }]} />
  <CollectionSchema slot="head" name="Proof Library" description="Proof pages for product, manufacturing, compliance and trade confidence." path="/proof/" items={proofPages.map((page) => ({ name: page.title, href: `/proof/${page.slug}/` }))} />
  <PageHero eyebrow="Proof library" title="Turn real manufacturing proof into sales confidence." description="These pages define every photo and document slot needed to make the site credible: product, factory, quality, batch, warehouse, retailer and distributor proof." image="/placeholders/factory.webp" primaryHref="/assets-needed/" primaryLabel="Photo shot list" secondaryHref="/quality/" secondaryLabel="Quality pages" />
  <section class="section grid three">{proofPages.map((page) => <a class="card text-card" href={`/proof/${page.slug}/`}><h3>{page.title}</h3><p>{page.summary}</p></a>)}</section>
</BaseLayout>
