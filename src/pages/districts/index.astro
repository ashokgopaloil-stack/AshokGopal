---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CollectionSchema from "../../components/CollectionSchema.astro";
import { districts } from "../../data/districts";
---
<BaseLayout title="West Bengal Mustard Oil Distribution" description="District-level mustard oil distributor and wholesale enquiry pages for West Bengal.">
  <CollectionSchema slot="head" name="West Bengal Mustard Oil Distribution" description="District-level trade pages" path="/districts/" items={districts.map((district) => ({ name: district.name, href: `/districts/${district.slug}/` }))} />
  <PageHero eyebrow="Local SEO" title="West Bengal district pages for distributor and retail enquiries." description="Use these pages to rank and route leads by district while keeping the main wholesale page focused." />
  <section class="section grid three">{districts.map((district) => <a class="card text-card" href={`/districts/${district.slug}/`}><h3>{district.name}</h3><p>{district.summary}</p></a>)}</section>
</BaseLayout>
