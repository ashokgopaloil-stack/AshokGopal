---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { districts } from "../../data/districts";
import { whatsappLink } from "../../data/site";
export function getStaticPaths() { return districts.map((district) => ({ params: { slug: district.slug }, props: { district } })); }
const { district } = Astro.props;
---
<BaseLayout title={district.headline} description={district.summary}>
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Districts", href: "/districts/" }, { name: district.name, href: `/districts/${district.slug}/` }]} />
  <section class="page-hero rich-hero"><div><p class="eyebrow">District wholesale page</p><h1>{district.headline}</h1><p class="lead">{district.summary}</p><div class="hero-actions"><a class="button" href={whatsappLink(`I want Ashok Gopal mustard oil supply in ${district.name}.`)}>WhatsApp enquiry</a><a class="button secondary" href="/wholesale/#wholesale-form">Wholesale form</a></div></div><img src="/placeholders/social-distribution.svg" alt={`${district.name} distribution placeholder`} /></section>
  <section class="grid three section"><div class="card text-card"><p class="eyebrow">Buyer types</p><ul>{district.buyerTypes.map((item) => <li>{item}</li>)}</ul></div><div class="card text-card"><p class="eyebrow">Priority markets</p><ul>{district.priorityMarkets.map((item) => <li>{item}</li>)}</ul></div><div class="card text-card"><p class="eyebrow">Recommended SKUs</p><ul>{district.recommendedSkus.map((item) => <li>{item}</li>)}</ul></div></section>
  <section class="section amber-block"><p class="eyebrow">Sales routing</p><h2>{district.name} lead handling note</h2><p>{district.leadAngle}</p></section>
  <CTA title={`Become an Ashok Gopal trade buyer in ${district.name}.`} text="Send firm name, GSTIN, delivery area, monthly volume, and pack requirement." href="/wholesale/#wholesale-form" label="Open enquiry form" />
</BaseLayout>
