---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CTA from "../../components/CTA.astro";
import { SITE } from "../../data/site";
---
<BaseLayout title="Social Content Plan" description="Instagram and Facebook content plan for Ashok Gopal mustard oil: product photos, recipe reels, factory proof, retailer proof, and distributor announcements.">
  <PageHero eyebrow="Social to search" title="Use Instagram and Facebook as discovery, but keep the website as the source of truth." description="The public social handles are linked. Add actual embedded posts or screenshots later. The current structure gives every campaign a landing page." image="/placeholders/social-preview.webp" primaryHref={SITE.social.instagram} primaryLabel="Instagram (@ashokgopaloil)" secondaryHref={SITE.social.facebook} secondaryLabel="Facebook" />
  <section class="grid three section">
    <div class="card product-card"><img src="/placeholders/social-recipe.webp" alt="Recipe post placeholder" /><div class="card-body"><h3>Recipe reels</h3><p>Link every reel to a matching recipe page and product SKU.</p></div></div>
    <div class="card product-card"><img src="/placeholders/social-packaging.webp" alt="Packaging post placeholder" /><div class="card-body"><h3>Packaging proof</h3><p>Show front pack, label, batch, MRP, and carton photos.</p></div></div>
    <div class="card product-card"><img src="/placeholders/social-distribution.webp" alt="Distribution post placeholder" /><div class="card-body"><h3>Retail and distributor proof</h3><p>Show shop counters, delivery, wholesale cartons, and territory announcements.</p></div></div>
  </section>
  <section class="section amber-block"><p class="eyebrow">Monthly content buckets</p><h2>Recommended social mix</h2><ul><li>8 recipe posts or reels</li><li>4 product/packaging proof posts</li><li>4 factory/process/trust posts</li><li>4 retailer/distributor proof posts</li><li>2 founder or behind-the-scenes posts</li></ul></section>
  <CTA />
</BaseLayout>
