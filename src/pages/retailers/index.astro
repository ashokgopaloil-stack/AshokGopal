<BaseLayout title="Retailer Supply" description="Ashok Gopal mustard oil supply for kirana stores, grocery retailers, and local retail counters.">
  <PageHero eyebrow="Retailers" title="Mustard oil supply for kirana stores and grocery counters." description="A focused page for shop owners who care about fast-moving SKUs, shelf fit, cartons, margins, and repeat supply." image="/placeholders/social-distribution.png" primaryHref="/wholesale/retailer/" primaryLabel="Retailer enquiry" secondaryHref="/products/kacchi-ghani-mustard-oil-retail-carton/" secondaryLabel="Retail carton page" />
  <section class="grid three section"><div class="card text-card"><h3>Core SKUs</h3><p>500 ml, 1 litre, and 5 litre are the retail-first pages.</p></div><div class="card text-card"><h3>Shelf story</h3><p>Use pungency, Bengali kitchen fit, and manufacturing trust.</p></div><div class="card text-card"><h3>Proof needed</h3><p>Add actual shop-counter and carton images.</p></div></section>
  <CTA />
</BaseLayout>
