---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import CollectionSchema from "../../components/CollectionSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { salesKitPages } from "../../data/salesKitPages";
---
<BaseLayout title="Sales Kit" description="Sales scripts, distributor qualification, sample SOP, rate-card workflow and WhatsApp reply library for Ashok Gopal." noindex={true}>
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Sales Kit", href: "/sales-kit/" }]} />
  <CollectionSchema slot="head" name="Sales Kit" description="Internal sales kit pages." path="/sales-kit/" items={salesKitPages.map((page) => ({ name: page.title, href: `/sales-kit/${page.slug}/` }))} />
  <PageHero eyebrow="Internal sales operations" title="Convert SEO leads into actual trade conversations." description="This cluster is noindexed by default because it is an internal operating kit for sales calls, WhatsApp replies, samples, rate cards and lead scoring." image="/placeholders/social-distribution.png" primaryHref="/rate-card/" primaryLabel="Rate-card workflow" secondaryHref="/samples/" secondaryLabel="Sample programme" />
  <section class="section grid three">{salesKitPages.map((page) => <a class="card text-card" href={`/sales-kit/${page.slug}/`}><h3>{page.title}</h3><p>{page.summary}</p></a>)}</section>
</BaseLayout>
