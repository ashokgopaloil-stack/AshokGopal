---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import LocalBusinessSchema from "../../components/LocalBusinessSchema.astro";
import { SITE } from "../../data/site";
---
<BaseLayout
  title="Contact Ashok Gopal"
  description="Contact Ashok Gopal for mustard oil sales, wholesale supply, distributor enquiries, retail supply, and manufacturing information."
>
  <Fragment slot="head">
    <LocalBusinessSchema />
    <BreadcrumbSchema items={[
      { name: "Home", href: "/" },
      { name: "Contact", href: "/contact/" }
    ]} />
  </Fragment>

  <nav class="breadcrumb"><a href="/">Home</a> / Contact</nav>

  <section class="page-hero">
    <p class="eyebrow">Contact</p>
    <h1>Sales, wholesale, and distributor support.</h1>
    <p>
      Use this page for verified business contact details, Google Business Profile consistency, and local search trust.
      Confirm all address and phone data before public launch.
    </p>
  </section>

  <section class="split-section">
    <div class="panel accent">
      <h2>Factory / sales office</h2>
      <p>
        {SITE.address.streetAddress}, {SITE.address.locality}, {SITE.address.city}, {SITE.address.region} - {SITE.address.postalCode}
      </p>
      <ul class="check-list">
        <li><a href={`tel:${SITE.phone}`}>{SITE.phone}</a></li>
        <li><a href={`https://wa.me/${SITE.whatsapp}`}>WhatsApp sales</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.instagram}>Instagram: @ashokgopaloil</a></li>
        <li><a href={SITE.facebook}>Facebook: Ashok Gopal Oil</a></li>
      </ul>
    </div>

    <div class="panel">
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <p hidden>
          <label>Do not fill this out: <input name="bot-field" /></label>
        </p>

        <div class="form-grid">
          <label>
            Name
            <input name="name" autocomplete="name" required />
          </label>

          <label>
            Mobile
            <input name="mobile" autocomplete="tel" required />
          </label>

          <label>
            Enquiry type
            <select name="enquiry_type" required>
              <option value="">Select</option>
              <option>Retail purchase</option>
              <option>Wholesale</option>
              <option>Distributor</option>
              <option>Restaurant / institutional</option>
              <option>Other</option>
            </select>
          </label>

          <label>
            City / district
            <input name="city" required />
          </label>

          <label class="full">
            Message
            <textarea name="message" required></textarea>
          </label>
        </div>

        <button class="button primary" type="submit">Send enquiry</button>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="panel">
      <p class="eyebrow">Map placeholder</p>
      <h2>Embed Google Map after Business Profile verification.</h2>
      <p>
        Add a Google Maps iframe here once the verified business profile URL and exact coordinates are confirmed.
      </p>
    </div>
  </section>
</BaseLayout>
