---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import { SITE, whatsappLink } from "../../data/site";
---
<BaseLayout title="Contact Ashok Gopal" description="Contact Ashok Gopal for mustard oil product enquiries, wholesale supply, distributor partnership, retail supply, restaurant supply, and institutional procurement.">
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Contact", href: "/contact/" }]} />
  <PageHero eyebrow="Sales and support" title="Contact Ashok Gopal for retail, wholesale, and product enquiries." description="Use WhatsApp for fastest qualification. For trade enquiries, include business type, district, GSTIN, monthly requirement, and pack size." image="/placeholders/social-distribution.svg" primaryHref={whatsappLink("I want to contact Ashok Gopal sales.")} primaryLabel="WhatsApp sales" secondaryHref="/wholesale/" secondaryLabel="Wholesale form" />
  <section class="form-shell section">
    <div>
      <p class="eyebrow">Contact details</p>
      <h2>{SITE.legalName}</h2>
      <p>{SITE.address.street}, {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}</p>
      <p><strong>Phone:</strong> {SITE.phone}</p>
      <p><strong>Email:</strong> {SITE.email}</p>
      <div class="social-links"><a href={SITE.social.instagram}>Instagram</a><a href={SITE.social.facebook}>Facebook</a></div>
    </div>
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden"><label>Do not fill this field<input name="bot-field" /></label></p>
      <input type="hidden" name="source_page" value="/contact/" />
      <label>Name<input name="name" required /></label>
      <label>Phone<input name="phone" required /></label>
      <label>Enquiry type<select name="type"><option>Retail purchase</option><option>Wholesale</option><option>Distributor</option><option>Restaurant supply</option><option>Institutional supply</option></select></label>
      <label class="full">Message<textarea name="message" rows="5"></textarea></label>
      <button class="button" type="submit">Send enquiry</button>
    </form>
  </section>
</BaseLayout>
