---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import CTA from "../../components/CTA.astro";
import { buyerUseCases } from "../../data/contentPages";
import { whatsappLink } from "../../data/site";
export function getStaticPaths() { return buyerUseCases.map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
---
<BaseLayout title={page.title} description={page.summary}>
  <BreadcrumbSchema slot="head" crumbs={[{ name: "Home", href: "/" }, { name: "Buyers", href: "/buyers/" }, { name: page.title, href: `/buyers/${page.slug}/` }]} />
  <section class="page-hero rich-hero"><div><p class="eyebrow">B2B buyer page</p><h1>{page.title}</h1><p class="lead">{page.summary}</p><div class="hero-actions"><a class="button" href={whatsappLink(page.ctaMessage)}>WhatsApp sales</a><a class="button secondary" href="/wholesale/#wholesale-form">Wholesale form</a></div></div><img src="/placeholders/social-distribution.png" alt="Trade supply placeholder" /></section>
  <section class="grid three section"><div class="card text-card"><p class="eyebrow">Recommended packs</p><ul>{page.recommendedPacks.map((item) => <li>{item}</li>)}</ul></div><div class="card text-card"><p class="eyebrow">Information to collect</p><ul>{page.requirements.map((item) => <li>{item}</li>)}</ul></div><div class="card text-card"><p class="eyebrow">Sales note</p><p>Add buyer-specific photos, testimonials, and MOQ once available.</p></div></section>
  <CTA title="Qualify this buyer quickly." text="Ask for monthly expected volume, GSTIN, delivery location, and preferred pack size." href="/wholesale/#wholesale-form" label="Open enquiry form" />
</BaseLayout>
