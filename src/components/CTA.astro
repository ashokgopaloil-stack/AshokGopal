---
interface Props {
  title: string;
  text: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { title, text, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---
<section class="cta-panel">
  <div>
    <p class="eyebrow">Sales and distribution</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="cta-actions">
    <a class="button primary" href={primaryHref}>{primaryLabel}</a>
    {secondaryHref && secondaryLabel && <a class="button secondary" href={secondaryHref}>{secondaryLabel}</a>}
  </div>
</section>
