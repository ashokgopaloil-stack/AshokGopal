---
import { SITE, whatsappLink } from "../data/site";
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Ashok Gopal home">
    <img src="/logo.svg" alt="Ashok Gopal logo" />
    <span>
      <strong>{SITE.name}</strong>
      <small>Kacchi Ghani Mustard Oil</small>
    </span>
  </a>
  <nav aria-label="Primary navigation">
    {SITE.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="header-cta" href={whatsappLink("I want to enquire about Ashok Gopal mustard oil supply.")}>WhatsApp Sales</a>
</header>
