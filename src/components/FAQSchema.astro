---
import JsonLd from "./JsonLd.astro";
interface FAQ {
  question: string;
  answer: string;
}
interface Props {
  faqs: readonly FAQ[];
}
const { faqs } = Astro.props;
const data = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};
---
<JsonLd data={data} />
