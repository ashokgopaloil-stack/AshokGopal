---
import JsonLd from "./JsonLd.astro";
import { SITE } from "../data/site";

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const data = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.name,
    item: new URL(crumb.href, SITE.url).toString()
  }))
};
---
<JsonLd data={data} />
