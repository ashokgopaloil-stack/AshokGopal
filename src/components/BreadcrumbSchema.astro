---
import JsonLd from "./JsonLd.astro";
import { SITE } from "../data/site";

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const data = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.href, SITE.url).toString()
  }))
};
---
<JsonLd data={data} />
