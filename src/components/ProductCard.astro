---
import type { Product } from "../data/products";
interface Props {
  product: Product;
}
const { product } = Astro.props;
---
<article class="card product-card">
  <a href={`/products/${product.slug}/`} aria-label={`Open ${product.name}`}>
    <img src={product.image} alt={`${product.name} packaging placeholder`} loading="lazy" />
  </a>
  <div class="card-body">
    <p class="eyebrow">{product.packSize}</p>
    <h3><a href={`/products/${product.slug}/`}>{product.shortName}</a></h3>
    <p>{product.summary}</p>
    <div class="tag-row">
      {product.idealFor.slice(0, 3).map((tag) => <span>{tag}</span>)}
    </div>
  </div>
</article>
